shopClose.TextScaled = true
shopClose.Text = "닫기"
shopClose.TextColor3 = Color3.new(1, 1, 1)
shopClose.BackgroundColor3 = Color3.fromRGB(90, 100, 130)
shopClose.ZIndex = 16
shopClose.Parent = shop
